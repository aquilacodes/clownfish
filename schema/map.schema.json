{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aquilacodes/clownfish/schema/map.schema.json",
  "title": "clownfish service map v1",
  "type": "object",
  "required": ["version", "generatedAt", "root", "stats", "services", "nodes", "edges", "flows", "warnings"],
  "$defs": {
    "shape": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "array", "string", "number", "boolean", "null", "unknown", "any"] },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/shape" } },
        "items": { "$ref": "#/$defs/shape" },
        "optional": { "type": "boolean" },
        "typeName": { "type": "string" },
        "source": { "enum": ["literal", "ts", "zod", "joi", "usage", "sql"] }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["file", "line", "col"],
      "properties": { "file": { "type": "string" }, "line": { "type": "integer" }, "col": { "type": "integer" }, "snippet": { "type": "string" } }
    }
  },
  "properties": {
    "version": { "const": "1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "root": { "type": "string" },
    "stats": {
      "type": "object",
      "properties": { "services": { "type": "integer" }, "files": { "type": "integer" }, "nodes": { "type": "integer" }, "edges": { "type": "integer" }, "flows": { "type": "integer" }, "durationMs": { "type": "integer" } }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "root", "kind"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" }, "root": { "type": "string" },
          "kind": { "enum": ["service", "library", "frontend", "lambda"] },
          "frameworks": { "type": "array", "items": { "type": "string" } },
          "language": { "enum": ["js", "ts", "mixed"] },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "ports": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["entry", "endpoint", "queue", "topic", "bus", "function", "sink", "external"] },
          "label": { "type": "string" },
          "service": { "type": "string" },
          "type": { "type": "string", "description": "http | ws | socket.io | sqs-consumer | lambda | postgres | mysql | redis | mongo | dynamodb | s3 | elasticsearch | sqs | sns | eventbridge | …" },
          "meta": { "type": "object" },
          "request": { "$ref": "#/$defs/shape" },
          "responses": { "type": "array", "items": { "type": "object", "properties": { "status": { "type": "integer" }, "shape": { "$ref": "#/$defs/shape" } } } },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "protocol", "confidence", "evidence"],
        "properties": {
          "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" },
          "protocol": { "enum": ["http", "ws", "sqs", "sns", "eventbridge", "lambda", "sql", "redis", "mongo", "dynamodb", "s3", "elasticsearch", "subscription", "invoke"] },
          "method": { "type": "string" }, "path": { "type": "string" },
          "operations": { "type": "array", "items": { "type": "string" } },
          "request": { "$ref": "#/$defs/shape" }, "response": { "$ref": "#/$defs/shape" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
          "meta": { "type": "object" }
        }
      }
    },
    "flows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "warnings": {
      "type": "array",
      "items": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "file": { "type": "string" }, "line": { "type": "integer" } } }
    }
  }
}
